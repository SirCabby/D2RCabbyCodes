// Windows version resource, so mod managers and Explorer show what this DLL is.
// The numbers come from the VERSION file through build/res/version_gen.h (Makefile).
#include <windows.h>
#include "version_gen.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    RC_VER_MAJOR,RC_VER_MINOR,RC_VER_PATCH,0
 PRODUCTVERSION RC_VER_MAJOR,RC_VER_MINOR,RC_VER_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x2L
 FILESUBTYPE    0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "SirCabby"
      VALUE "FileDescription",  "CabbyCodes for Diablo II: Resurrected (D2RLoader plugin)"
      VALUE "FileVersion",      RC_VER_STR
      VALUE "InternalName",     "d2rl-cabbycodes"
      VALUE "LegalCopyright",   "GPL-3.0"
      VALUE "OriginalFilename", "d2rl-cabbycodes.dll"
      VALUE "ProductName",      "D2RCabbyCodes"
      VALUE "ProductVersion",   RC_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
